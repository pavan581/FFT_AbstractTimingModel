FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    tar \
    ca-certificates \
    bzip2 \
    xz-utils \
    file \
    python3 \
    git \
    bash-completion git \
    vim \
    && rm -rf /var/lib/apt/lists/*

ARG BOOST_VERSION=1.84.0
ARG BOOST_VERSION_UNDERSCORE=1_84_0

ENV BOOST_HOME=/opt/boost

RUN mkdir -p /tmp/boost && cd /tmp/boost \
    && wget -O boost.tar.bz2 "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_UNDERSCORE}.tar.bz2" \
    && tar -xjf boost.tar.bz2 \
    && cd "boost_${BOOST_VERSION_UNDERSCORE}" \
    && ./bootstrap.sh --prefix="${BOOST_HOME}" \
    && ./b2 -j"$(nproc)" install \
         --prefix="${BOOST_HOME}" \
         variant=release \
         link=shared \
         threading=multi \
    && rm -rf /tmp/boost

ENV CPATH=${BOOST_HOME}/include:${CPATH}
ENV LIBRARY_PATH=${BOOST_HOME}/lib:${LIBRARY_PATH}
ENV LD_LIBRARY_PATH=${BOOST_HOME}/lib:${LD_LIBRARY_PATH}

ARG SYSTEMC_VERSION=2.3.3
ENV SYSTEMC_HOME=/opt/systemc
ENV SYSTEMC_URL=https://github.com/accellera-official/systemc/archive/refs/tags/${SYSTEMC_VERSION}.tar.gz

RUN mkdir -p /tmp/systemc && cd /tmp/systemc \
    && wget -O systemc.tar.gz "${SYSTEMC_URL}" \
    && tar -xzf systemc.tar.gz --strip-components=1 \
    && test -f configure \
    && mkdir -p objdir && cd objdir \
    && ../configure --prefix="${SYSTEMC_HOME}" \
    && make -j"$(nproc)" \
    && make install \
    && if [ ! -f "${SYSTEMC_HOME}/include/sysc/kernel/sc_reset.h" ]; then \
         echo "SystemC internal headers missing; copying src/sysc -> include/sysc"; \
         mkdir -p "${SYSTEMC_HOME}/include"; \
         cp -a ../src/sysc "${SYSTEMC_HOME}/include/"; \
         cp -a ../src/systemc "${SYSTEMC_HOME}/include/" || true; \
       fi \
    && rm -rf /tmp/systemc

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-numpy \
    python3-pandas \
    python3-scipy \
    python3-matplotlib \

ENV LD_LIBRARY_PATH=${SYSTEMC_HOME}/lib-linux64:${LD_LIBRARY_PATH}

ENV CMAKE_PREFIX_PATH=${SYSTEMC_HOME}:${BOOST_HOME}:${CMAKE_PREFIX_PATH}

WORKDIR /workspace
CMD ["/bin/bash"]